generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gym {
  id        String    @id @default(cuid())
  name      String
  cnpj      String?   @unique
  email     String?   @unique
  phone     String?
  address   String?
  city      String?
  state     String?
  isActive  Boolean   @default(true)
  plan      String    @default("basic")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
  members   Member[]
  todos     Todo[]
  trainers  Trainer[]
  users     User[]
  workouts  Workout[]

  @@map("gyms")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String?   @unique
  emailVerified            DateTime?
  image                    String?
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String?
  stripePriceId            String?
  gymId                    String?
  role                     String    @default("user")
  accounts                 Account[]
  expenses                 Expense[]
  members                  Member[]
  sessions                 Session[]
  todos                    Todo[]
  trainers                 Trainer[]
  gym                      Gym?      @relation(fields: [gymId], references: [id])
  workouts                 Workout[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Todo {
  id        String    @id @default(cuid())
  title     String
  userId    String
  gymId     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  doneAt    DateTime?
  gym       Gym?      @relation(fields: [gymId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("todos")
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  description String?
  amount      Float
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  gymId       String?
  gym         Gym?     @relation(fields: [gymId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("expenses")
}

model Trainer {
  id             String    @id @default(cuid())
  name           String
  email          String
  phone          String
  specialty      String
  status         String
  certifications String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  gymId          String?
  members        Member[]
  gym            Gym?      @relation(fields: [gymId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
  workouts       Workout[]

  @@map("trainers")
}

model Member {
  id              String          @id @default(cuid())
  name            String
  email           String
  phone           String
  plan            String
  status          String
  lastVisit       String
  trainerId       String?
  userId          String
  planRenewalDate String
  paymentDate     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  gymId           String?
  gym             Gym?            @relation(fields: [gymId], references: [id])
  trainer         Trainer?        @relation(fields: [trainerId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  workoutMembers  WorkoutMember[]

  @@map("members")
}

model Workout {
  id             String          @id @default(cuid())
  name           String
  type           String
  duration       String
  level          String
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  gymId          String?
  trainerId      String?
  workoutMembers WorkoutMember[]
  gym            Gym?            @relation(fields: [gymId], references: [id])
  trainer        Trainer?        @relation(fields: [trainerId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  @@map("workouts")
}

model WorkoutMember {
  id         String   @id @default(cuid())
  workoutId  String
  memberId   String
  assignedAt DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, memberId])
  @@map("workout_members")
}
