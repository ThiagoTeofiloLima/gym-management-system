// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String?
  stripePriceId            String?

  accounts  Account[]
  sessions  Session[]
  todos     Todo[]
  expenses  Expense[]
  trainers  Trainer[]
  members   Member[]
  workouts  Workout[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Todo {
  id    String @id @default(cuid())
  title String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  doneAt    DateTime?
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  description String?
  amount      Float
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("expenses")
}

model Trainer {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String
  specialty         String
  status            String
  certifications    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id])
  members   Member[]
  workouts  Workout[]

  @@map("trainers")
}

model Member {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String
  plan              String
  status            String
  lastVisit         String
  trainerId         String?
  userId            String
  planRenewalDate   String
  paymentDate       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  trainer   Trainer?  @relation(fields: [trainerId], references: [id])
  workoutMembers    WorkoutMember[]

  @@map("members")
}

model Workout {
  id                String   @id @default(cuid())
  name              String
  type              String
  duration          String
  level             String
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id])
  trainerId String?
  trainer   Trainer?  @relation(fields: [trainerId], references: [id])
  workoutMembers    WorkoutMember[]

  @@map("workouts")
}

// Join table for many-to-many relationship between Workout and Member
model WorkoutMember {
  id        String @id @default(cuid())
  workoutId String
  memberId  String
  assignedAt DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([workoutId, memberId])
  @@map("workout_members")
}