# ============================================
# Gym Manager Micro-SaaS - Variáveis de Ambiente
# ============================================

# ============================================
# BANCO DE DADOS
# ============================================
DATABASE_URL="postgresql://postgres:2002@localhost:5432/microsaas_gyms?schema=public"

# ============================================
# AUTENTICAÇÃO
# ============================================
# Chave gerada para desenvolvimento - EM PRODUÇÃO, GERE NOVA CHAVE!
AUTH_SECRET="dev-secret-key-for-production-use-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USER_EMAIL="admin@gymmanager.com.br"

# ============================================
# OAUTH PROVIDERS
# ============================================
# Preencha com suas credenciais reais dos providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============================================
# EMAIL (Magic Link)
# ============================================
EMAIL_SERVER="smtp.mailtrap.io"
EMAIL_PORT="2525"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="noreply@gymmanager.com.br"

# ============================================
# STRIPE
# ============================================
STRIPE_PUBLISHABLE_KEY="pk_test_123456789"
STRIPE_SECRET_KEY="sk_test_123456789"
STRIPE_WEBHOOK_SECRET="whsec_123456789"
