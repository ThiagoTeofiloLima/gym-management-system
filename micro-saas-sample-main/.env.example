# ============================================
# Variáveis de Ambiente - Gym Manager Micro-SaaS
# ============================================
# Copie este arquivo para .env e preencha com seus dados reais
# ============================================

# ============================================
# 1. BANCO DE DADOS (PostgreSQL)
# ============================================
# Produção: Use Supabase, Neon, Railway ou similar
# Exemplo: postgresql://user:senha@host:5432/microsaas_gyms
DATABASE_URL="postgresql://postgres:2002@localhost:5432/microsaas_gyms?schema=public"

# ============================================
# 2. NEXTAUTH / AUTENTICAÇÃO
# ============================================
# Gere uma chave segura com: openssl rand -base64 32
# Em produção, use uma variável de ambiente do seu hosting (Vercel, etc)
AUTH_SECRET="sua-chave-secreta-aqui-gerada-com-openssl"

# URL da aplicação em produção
# Produção: https://seusaas.com
# Desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email do administrador principal (para referência)
NEXT_PUBLIC_USER_EMAIL="admin@gymmanager.com.br"

# ============================================
# 3. GOOGLE OAUTH
# ============================================
# Crie em: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://seusaas.com/api/auth/callback/google
# (Em dev: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID="seu-google-client-id"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# ============================================
# 4. GITHUB OAUTH
# ============================================
# Crie em: https://github.com/settings/developers
# Redirect URI: https://seusaas.com/api/auth/callback/github
# (Em dev: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID="seu-github-client-id"
AUTH_GITHUB_SECRET="seu-github-client-secret"

# ============================================
# 5. EMAIL / MAGIC LINK (Resend, SendGrid, etc)
# ============================================
# Produção: Use Resend, SendGrid, AWS SES ou similar
# Mailtrap é apenas para desenvolvimento
EMAIL_SERVER="smtp.mailtrap.io"
EMAIL_PORT="2525"
EMAIL_USER="seu-mailtrap-username"
EMAIL_PASSWORD="seu-mailtrap-password"
EMAIL_FROM="noreply@gymmanager.com.br"

# ============================================
# 6. STRIPE (Pagamentos)
# ============================================
# Produção: Use as chaves live (pk_live_, sk_live_)
# Desenvolvimento: Use as chaves test (pk_test_, sk_test_)
# Webhook: https://dashboard.stripe.com/test/webhooks
# (Em produção: https://seusaas.com/api/stripe/webhook)

STRIPE_PUBLISHABLE_KEY="pk_test_sua-chave-aqui"
STRIPE_SECRET_KEY="sk_test_sua-chave-aqui"
STRIPE_WEBHOOK_SECRET="whsec_seu-webhook-secret"

# IDs dos produtos/preços do Stripe (após criar os produtos)
# STRIPE_PRICE_ID_BASIC="price_xxxxx"
# STRIPE_PRICE_ID_PRO="price_xxxxx"
# STRIPE_PRICE_ID_ENTERPRISE="price_xxxxx"

# ============================================
# 7. CONFIGURAÇÕES ADICIONAIS
# ============================================
# Node environment
NODE_ENV="development"

# Log level (development only)
# LOG_LEVEL="debug"
